    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Giá trị cảm biến mới nhất",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/sensor-data/latest",
            "description": "Trả null nếu chưa có MQTT dữ liệu thật. Trường light là lux ước tính đã được backend quy đổi từ ADC, không phải ADC thô. Ví dụ: {\"temperature\":28.5,\"humidity\":71,\"light\":19.6,\"time\":\"2026-10-11 20:00:00\"}.\nExpected status: 200",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b=pm.response.json(); if(b.light!==null) pm.expect(b.light).to.be.a('number').and.at.least(0);"
                ]
              }
            }
          ]
        },
        {
          "name": "Dữ liệu biểu đồ",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/sensor-data/chart?limit=20",
            "description": "Chuỗi light chứa lux ước tính đã quy đổi. Ví dụ điểm dữ liệu: {\"time\":\"2026-10-11 20:00:00\",\"value\":19.6}.\nExpected status: 200",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b=pm.response.json(); pm.expect(b).to.have.property('light'); if(b.light.length) pm.expect(b.light[0].value).to.be.a('number').and.at.least(0);"
                ]
              }
            }
          ]
        }
      ]
    },
