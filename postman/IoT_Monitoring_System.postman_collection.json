{
  "info": {
    "_postman_id": "b8955850-62fd-4d56-8d40-918be1b65bfa",
    "name": "IoT Monitoring System API",
    "description": "API thật của Node.js backend trong cùng ZIP. Chạy npm start trên máy có MySQL/MQTT. Không cung cấp mật khẩu/token thật.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Đăng nhập - hợp lệ",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Thay username/password trong environment bằng tài khoản đã tạo qua npm run create-admin.\nExpected status: 200",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b=pm.response.json(); if(b.token) pm.environment.set(\"token\",b.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập - sai mật khẩu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "\nExpected status: 401",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"__INVALID_PASSWORD__\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Thông tin người dùng",
          "request": {
            "method": "GET",
