    {
      "name": "Device Control",
      "item": [
        {
          "name": "Device 1 ON - YÊU CẦU PHẦN CỨNG",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/devices/1/control",
            "description": "Chỉ chạy khi MQTT kết nối và Arduino đang bật. Nếu offline có thể trả 503; 202 là PENDING, không chứng minh LED đã bật.\nExpected status: 202",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"ON\"\n}",
